# ---- General ----
NODE_ENV=production
APP_URL=https://dashboard.yourdomain.com

# ---- Database ----
DATABASE_URL=postgresql://workspaceos:changeme@postgres:5432/workspaceos

# ---- Auth (Google OAuth) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

# ---- JWT ----
JWT_ACCESS_SECRET=changeme-access-secret-min-32-chars
JWT_REFRESH_SECRET=changeme-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Credential encryption (envelope root key, 32 bytes base64) ----
MASTER_ENCRYPTION_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ---- Guacamole (browser-based RDP, Phase 4) ----
# GUACAMOLE_INTERNAL_URL is set directly in docker-compose.yaml (private
# network only) and does not need to be set here.
# GUACAMOLE_PUBLIC_URL: the domain you assign to the `guacamole` Coolify
# service, with /guacamole appended, e.g.:
GUACAMOLE_PUBLIC_URL=https://guac.yourdomain.com/guacamole
# JSON_SECRET_KEY: 32 hex chars (128-bit), shared by the `api` and
# `guacamole` services only. Generate once with:
#   openssl rand -hex 16
JSON_SECRET_KEY=

# ---- Owner bootstrap ----
OWNER_EMAIL=charlesauthur477@gmail.com

# ---- Ports (local/dev) ----
API_PORT=4000
WEB_PORT=3000
