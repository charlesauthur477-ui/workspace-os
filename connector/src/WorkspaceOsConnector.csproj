<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinExe + UseWindowsForms so the app has no console window and can
         show a tray icon + small dialogs (pairing code entry, toast on
         launch failure) instead of running headless. -->
    <AssemblyName>WorkspaceOsConnector</AssemblyName>
    <!-- Add ApplicationIcon here once you have a real .ico for the tray. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
